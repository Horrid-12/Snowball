# Snowball — Environment Variables
# Copy this file to .env and fill in your values.

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (used for CORS + redirects)
# FRONTEND_URL=http://localhost:5173

# Database (example — uncomment and configure when adding a database)
# DATABASE_URL=mongodb://localhost:27017/snowball

# Authentication (example — uncomment when adding auth)
# JWT_SECRET=your-secret-key-here

# Supabase
# SUPABASE_URL=https://mathicklwljopjvzwnny.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# YouTube Data API
# YOUTUBE_API_KEY=your_youtube_data_api_key_here
