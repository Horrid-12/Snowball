# Snowball - Environment Variables
# Copy this file to .env and fill in your values.

# Server
PORT=3000
NODE_ENV=development

# Public URLs used for CORS and OAuth redirects.
# The defaults below suit local development and can stay commented out.
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:3000

# Authentication (required)
# Any long random string works in development, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google Calendar integration (optional)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Spotify integration for the Media Hub (optional)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# YouTube playlist import (optional - search works without a key)
# YOUTUBE_API_KEY=your_youtube_data_api_key

# Postgres connection string, only needed for backend/migrate_supabase.js
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Discord Rich Presence is enabled with a frontend build-time variable.
# Set VITE_DISCORD_CLIENT_ID in frontend/.env (optional; a default is baked
# into frontend/src/config.js). It is not a sign-in credential.
