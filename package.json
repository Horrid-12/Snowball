{
    "name":  "snowball",
    "version":  "8.1.2",
    "description":  "Snowball — Full-stack application with Vite frontend and Express backend",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev:frontend":  "npm --prefix frontend run dev",
                    "dev:backend":  "npm --prefix backend run dev",
                    "dev":  "npx -y concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
                    "install:all":  "npm --prefix frontend install \u0026\u0026 npm --prefix backend install",
                    "build":  "npm --prefix frontend run build",
                    "release":  "node -e \"process.platform===\u0027win32\u0027?require(\u0027child_process\u0027).execSync(\u0027powershell -NoProfile -ExecutionPolicy Bypass -File .\\\\scripts\\\\release.ps1\u0027,{stdio:\u0027inherit\u0027}):require(\u0027child_process\u0027).execSync(\u0027bash ./scripts/release.sh\u0027,{stdio:\u0027inherit\u0027})\"",
                    "release:win":  "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1",
                    "release:unix":  "bash ./scripts/release.sh",
                    "release:all":  "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1 -Vercel -Tauri -Android -CiDesktop",
                    "release:sync":  "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1 -SkipVersionSync -DryRun",
                    "release:commit":  "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1 -Vercel -Tauri -Android -CiDesktop -GitCommit",
                    "release:publish":  "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\release.ps1 -Vercel -Tauri -Android -CiDesktop -GitCommit -GitPush",
                    "postinstall":  "npm run install:all"
                },
    "dependencies":  {
                         "@vercel/analytics":  "^1.6.1"
                     }
}
