{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "Snowball",
    "version":  "7.1.2",
    "identifier":  "com.howwid.Snowball",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://127.0.0.1:5173",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Snowball.",
                                    "width":  800,
                                    "height":  600,
                                    "resizable":  true,
                                    "titleBarStyle":  "Visible",
                                    "scrollBarStyle":  "fluentOverlay"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRjkxQzQ0MDJFNjM2MEIKUldRTE51WUNSQno1Y1BuY2hHSUxqNVovSHVERDcwcEtpY1poUkZwT3FqRG1Ib0JvRzM4VXd5NDUK",
                                    "endpoints":  [
                                                      "https://github.com/Horrid-12/Snowball/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}
